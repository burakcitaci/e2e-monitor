# Backend process
# Messaging chatbot (server only; never put this key in a VITE_ variable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NODE_ENV=development
MESSAGE_PROCESSING_MODE=manual
PORT=3000
CAPTURE_TOKEN=local-capture-token
CORS_ORIGIN=http://localhost:4200

# Azure Service Bus emulator
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;UseDevelopmentEmulator=true
SERVICE_BUS_NAMESPACE=sbemulatorns
SERVICE_BUS_QUEUE=orders-queue
SERVICE_BUS_MAX_RETRIES=3
SERVICE_BUS_RETRY_DELAY=1000

# MongoDB
MONGO_URI=mongodb://testuser:testpass@localhost:27017/
MONGO_MESSAGE_DB=MessageTrackingDb
MONGO_AUTH_SOURCE=admin

# LocalStack SQS
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SQS_QUEUE_NAME=orders-queue

# API throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=60
