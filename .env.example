# Backend process
# Messaging chatbot (server only; never put this key in a VITE_ variable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NODE_ENV=development
PORT=3000
CAPTURE_TOKEN=local-capture-token
CORS_ORIGIN=http://localhost:4200

# Broker management (server only; leave AWS_ENDPOINT_URL empty for real AWS)
SERVICE_BUS_ADMIN_CONNECTION_STRING=Endpoint=sb://localhost:5300;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# MongoDB
MONGO_URI=mongodb://testuser:testpass@localhost:27017/
MONGO_MESSAGE_DB=MessageTrackingDb
MONGO_AUTH_SOURCE=admin

# API throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=60
